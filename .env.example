# Copy to .env.local. For local dev: `npm run db:start` prints these values (`npx supabase status -o env`).
# Supabase project URL (local: http://127.0.0.1:55321)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER/SCRIPTS ONLY (import script, integration tests). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL (local: http://localhost:3100)
NEXT_PUBLIC_SITE_URL=
# Optional: Plausible analytics domain (leave empty to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
